# Variáveis do docker compose de produção. Copie para .env e preencha.

# Domínio público (o DNS precisa apontar para o servidor)
DOMINIO=votacao.exemplo.com.br
# Segredo dos logins, 16+ caracteres. Gere com: openssl rand -hex 32
JWT_SECRET=
# Primeiro administrador (criado só se o banco não tiver nenhum)
ADMIN_LOGIN=admin
ADMIN_SENHA=
# Fuso da regra dos 3 anos de colete e dos PDFs
APP_TZ=America/Sao_Paulo
