# Copie para .env antes de rodar o docker compose.
# Servidor do River (nginx dele na frente):
COMPOSE_FILE=docker-compose.yml:docker-compose.river.yml
# Servidor só desta aplicação (Caddy na frente): troque a linha acima por esta e defina DOMINIO.
# COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
# DOMINIO=mc.riversoftware.tech

# Segredo dos logins. Gere com: openssl rand -hex 32
JWT_SECRET=
# Primeiro administrador (criado só se não houver nenhum)
ADMIN_LOGIN=admin
ADMIN_SENHA=
# Fuso usado na regra dos 3 anos de colete e nos PDFs
APP_TZ=America/Sao_Paulo
