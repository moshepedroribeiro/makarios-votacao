# Porta da API
PORT=8080
# Arquivo do banco SQLite (padrão: ./data/makarios.db)
DATABASE_FILE=./data/makarios.db
# Segredo dos logins (obrigatório em produção, 16+ caracteres)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Primeiro administrador (criado só se não houver nenhum)
ADMIN_LOGIN=admin
ADMIN_SENHA=troque-esta-senha
# Fuso usado na regra dos 3 anos de colete e nos PDFs
APP_TZ=America/Sao_Paulo
NODE_ENV=production
